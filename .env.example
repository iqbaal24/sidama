# Salin menjadi .env lalu sesuaikan.
DJANGO_SECRET_KEY=ganti-dengan-kunci-acak-yang-panjang
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: sqlite (default) atau postgres
DB_ENGINE=sqlite
POSTGRES_DB=sidama
POSTGRES_USER=sidama
POSTGRES_PASSWORD=sidama
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=1

# Notifikasi Telegram (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (reset password). Kosong = cetak ke konsol.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=SIDAMA <noreply@sidama.local>
